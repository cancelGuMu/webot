# === AI Backend: "claude" or "deepseek" ===
AI_BACKEND=deepseek

# === Claude / Anthropic (only needed if AI_BACKEND=claude) ===
ANTHROPIC_API_KEY=
# Anthropic API Base URL (可填兼容代理/中转服务)
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model: claude-haiku-4-5-20251001 (fast/cheap) or claude-sonnet-4-5-20250929 (better quality)
SUMMARIZE_MODEL=claude-haiku-4-5-20251001

# === DeepSeek (only needed if AI_BACKEND=deepseek) ===
# 在此填入你的 DeepSeek API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DeepSeek API Base URL (可填 OpenAI-compatible 代理/中转服务)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型: deepseek-v4-flash (推荐, 极速/极低价格) 或 deepseek-v4-pro (1M上下文, 旗舰)
DEEPSEEK_MODEL=deepseek-v4-flash

# === WeChat 数据目录（可选，留空则自动检测）===
# 如果微信聊天记录不在默认路径（Documents\xwechat_files 或 Documents\WeChat Files），
# 请在此填写包含 wxid_* 文件夹的父目录绝对路径。
# 例如: D:\WeChatData 或 C:\Users\xxx\AppData\Roaming\Tencent\WeChat
WECHAT_DATA_DIR=

# === WeChat Backend ===
# Windows: wcdb. macOS: mac_hybrid (WeFlow WCDB read + Accessibility send) or mac_ui fallback.
WECHAT_BACKEND=wcdb
# Optional: override the detected macOS WeChat account data directory.
MAC_WEFLOW_DATA_DIR=
# macOS WeChat send shortcut: enter or cmd_enter.
MAC_WECHAT_SEND_SHORTCUT=enter
# Comma-separated group names. "*" = auto-discover all groups.
WECHAT_GROUPS=

# === Bot Identity ===
# Your bot's WeChat display name. Used for @mention detection.
BOT_DISPLAY_NAME=群聊小助手

# === Trigger Keywords ===
# Comma-separated. The bot also responds to @mentions regardless of keywords.
TRIGGER_KEYWORDS=总结一下,之前发了什么,错过了什么,summarize,what did i miss,聊天总结,帮我总结,前面说了什么,说了啥,发生了什么

# === Database ===
DB_PATH=data/messages.db

# === Features ===

# 趣味功能 — @机器人抽签，返回随机运势签文（true/false）
FUN_ENABLED=true

# === Tuning ===
# Seconds between message polls (default: 1.0, increase for lower CPU usage)
POLL_INTERVAL_SEC=1.0
# Minimum seconds between trigger responses in the same chat (dedup)
DEDUP_WINDOW_SEC=60
# Max messages to include in summary prompt.
# For groups with 999+ messages, increase this value.
# The bot uses token estimation + automatic chunking (map-reduce) to handle
# very large conversations safely within the model's context window.
MAX_MESSAGES_FOR_SUMMARY=5000
# Messages per chunk when map-reduce is triggered (default: 400)
CHUNK_SIZE=400
# If requester has no prior message, or the detected window is too small,
# expand to this many hours (minimum summary window)
FALLBACK_WINDOW_HOURS=8

# === Proactive Participation ===
# Master switch — enable autonomous chat participation without @mention
PROACTIVE_ENABLED=false
# Rate calculation window in seconds (default: 120 = 2 minutes)
PROACTIVE_RATE_WINDOW_SEC=120
# Message rate thresholds (msgs/min) for each mode.
# Calibrate by running: python tools/analyze_chat_rhythm.py
PROACTIVE_RATE_QUIET=1.5
PROACTIVE_RATE_CASUAL=4.0
PROACTIVE_RATE_LIVELY=6.5
PROACTIVE_RATE_BURST=8.5

# === Sticky Mention ===
# When a user sends @bot with no message text, the bot enters sticky
# listening mode.  The user's next message in the same group is treated
# as if it were @mentioned (one-shot — consumed on first non-empty follow-up).
# Set to false to disable entirely.
STICKY_MENTION_ENABLED=true
# Max seconds to wait for the follow-up message after an empty @mention
STICKY_MENTION_TTL_SEC=60

# === Logging ===
LOG_LEVEL=INFO
# Optional log file (leave empty for console only)
LOG_FILE=data/bot.log
